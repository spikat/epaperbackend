<div class="quadrant-fill">
  <div class="q-title">{{ data.location.name }}</div>
  <img class="q-icon" src="{{ config.backend_url }}{{ data.current.icon_url }}" alt="{{ data.current.icon }}"/>
  <div class="q-temp">{{ data.current.temperature_c }}°C</div>
  <div class="q-meta">
    <div>Vent {{ data.current.wind_speed_kmh }} km/h</div>
    <div>Humidité {{ data.current.humidity_pct }}%</div>
  </div>
</div>
